# Secret that /api/resume requires as `Authorization: Bearer <token>`.
# Use a long random value, e.g. `openssl rand -base64 32`. At least 24 characters.
RESUME_ADMIN_TOKEN=

# Optional: canonical origin for metadata, sitemap and structured data, once you
# have a custom domain. Defaults to the Vercel production URL.
NEXT_PUBLIC_SITE_URL=

# Read-write token for the Vercel Blob store that holds the resume.
# Vercel adds this automatically when you connect a Blob store to the project.
BLOB_READ_WRITE_TOKEN=

# Mixpanel project token (Project settings → Access keys). It's meant to be
# public: the browser sends it with every event, hence the NEXT_PUBLIC_ prefix.
# Leave empty to disable tracking.
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Optional: Mixpanel ingestion endpoint. Must match the project's data residency
# or events are silently dropped. Defaults to US (https://api.mixpanel.com).
# EU: https://api-eu.mixpanel.com   India: https://api-in.mixpanel.com
NEXT_PUBLIC_MIXPANEL_API_HOST=
